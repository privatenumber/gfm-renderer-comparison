    "fetch:gfm-spec": "node scripts/fetch-gfm-spec.ts",
    "fetch:github": "GITHUB_TOKEN=\"${GITHUB_TOKEN:-$(gh auth token)}\" node scripts/fetch-github-api.ts",
    "fetch:meta": "GITHUB_TOKEN=\"${GITHUB_TOKEN:-$(gh auth token)}\" node scripts/fetch-renderer-meta.ts",
    "diffs": "node scripts/diff-renderers.ts",
    "render": "node scripts/render.ts",
