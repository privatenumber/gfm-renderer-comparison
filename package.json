    "type-check": "tsc",
    "report": "mdeval README.md"
  },
  "dependencies": {
    "@khanacademy/simple-markdown": "^2.2.3",
    "commonmark": "^0.31.2",
    "gemoji": "^8.1.0",
    "hast-util-from-html": "^2.0.3",
    "highlight.js": "^11.11.1",
    "hoedown": "^0.4.1",
    "markdown": "^0.5.0",
    "markdown-it": "^14.2.0",
    "markdown-it-task-lists": "^2.1.1",
    "marked": "^18.0.4",
    "marked-alert": "^2.1.2",
    "marked-emoji": "^2.0.3",
    "marked-footnote": "^1.4.0",
    "marked-highlight": "^2.2.4",
    "md4w": "^0.2.7",
    "micro-down": "^1.6.2",
    "micromark": "^4.0.2",
    "micromark-extension-gfm": "^3.0.0",
    "nano-markdown": "^1.2.2",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "showdown": "^2.1.0",
    "snarkdown": "^2.0.0",
    "unified": "^11.0.5"
  },
  "optionalDependencies": {
    "cmark-gfm": "^0.9.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "cleye": "^2.6.0",
    "manten": "^2.0.0",
    "md-pen": "^1.2.0",
    "mdeval": "^1.5.0",
    "mitata": "^1.0.34",
    "nano-spawn": "^2.1.0",
    "quickchart-js": "^3.1.3",
