{
  "private": true,
  "type": "module",
  "scripts": {
    "build:hoedown": "node lib/renderers/adapters/hoedown/build.ts",
    "build:pulldown": "node lib/renderers/adapters/pulldown-cmark/build.ts",
    "build:comrak": "node lib/renderers/adapters/comrak/build.ts",
    "build:markdown-rs": "node lib/renderers/adapters/markdown-rs/build.ts",
