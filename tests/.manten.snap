  "micromark:footnote": "'<p>Here is a statement with a footnote.<sup><a href=\"#user-content-fn-1\" id=\"user-content-fnref-1\" data-footnote-ref=\"\" aria-describedby=\"footnote-label\">1</a></sup></p>\\n' +\n  '<section data-footnotes=\"\" class=\"footnotes\"><h2 id=\"footnote-label\" class=\"sr-only\">Footnotes</h2>\\n' +\n  '<ol>\\n' +\n  '<li id=\"user-content-fn-1\">\\n' +\n  '<p>This is the footnote definition. <a href=\"#user-content-fnref-1\" data-footnote-backref=\"\" aria-label=\"Back to reference 1\" class=\"data-footnote-backref\">↩</a></p>\\n' +\n  '</li>\\n' +\n  '</ol>\\n' +\n  '</section>'",
  "micromark:footnote-multiple": "'<p>First reference<sup><a href=\"#user-content-fn-a\" id=\"user-content-fnref-a\" data-footnote-ref=\"\" aria-describedby=\"footnote-label\">1</a></sup> and second reference<sup><a href=\"#user-content-fn-b\" id=\"user-content-fnref-b\" data-footnote-ref=\"\" aria-describedby=\"footnote-label\">2</a></sup> in one paragraph.</p>\\n' +\n  '<section data-footnotes=\"\" class=\"footnotes\"><h2 id=\"footnote-label\" class=\"sr-only\">Footnotes</h2>\\n' +\n  '<ol>\\n' +\n  '<li id=\"user-content-fn-a\">\\n' +\n  '<p>First footnote. <a href=\"#user-content-fnref-a\" data-footnote-backref=\"\" aria-label=\"Back to reference 1\" class=\"data-footnote-backref\">↩</a></p>\\n' +\n  '</li>\\n' +\n  '<li id=\"user-content-fn-b\">\\n' +\n  '<p>Second footnote with <strong>bold</strong>. <a href=\"#user-content-fnref-b\" data-footnote-backref=\"\" aria-label=\"Back to reference 2\" class=\"data-footnote-backref\">↩</a></p>\\n' +\n  '</li>\\n' +\n  '</ol>\\n' +\n  '</section>'",
