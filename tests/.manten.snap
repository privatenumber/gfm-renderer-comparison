  "nano-markdown:html-block": "'<p><div class=\"note\">\\n  <p>A raw HTML block.</p>\\n</div></p>'",
  "nano-markdown:html-inside-table": "'<p>| Tag | Example |\\n' +\n  '| --- | ------- |\\n' +\n  '| bold | <strong>hi</strong> |\\n' +\n  '| break | a<br>b |</p>'",
  "nano-markdown:image": "'<p><img src=\"https://example.com/image.png\" alt=\"alt text\" title=\"Image Title\"/></p>'",
  "nano-markdown:indented-code": "'<p>indented code block\\n    second line</p>'",
