{
  "compilerOptions": {
    // Type-check only — Node runs the .ts sources directly via type stripping.
    "noEmit": true,
    "allowImportingTsExtensions": true,

    // Match Node's runtime: native ESM, no downleveling, .ts extensions in imports.
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["esnext"],
    "types": ["node"],

    // Guardrails: keep the source Node-strippable and the types honest.
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "skipLibCheck": true
  }
}
